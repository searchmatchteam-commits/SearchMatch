<%- include('partials/head', { titulo: 'Recuperar contraseña', descripcion: 'Recupera el acceso a tu cuenta de SearchMatch.' }) %>
<body class="auth-body auth-pagina">

  <%- include('partials/auth-nav', { accion: 'login' }) %>

  <!-- Contenido centrado (mismo estilo que el login) -->
  <main class="auth-centro">
    <section class="auth">
      <div class="auth-logo"><span class="material-symbols-outlined">lock_reset</span></div>
      <h1 class="auth-titulo">¿Olvidaste tu contraseña?</h1>
      <p class="auth-subtitulo">Escribe tu correo y te enviaremos un enlace<br>para crear una contraseña nueva</p>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>
      <% if (exito) { %>
        <div class="alert alert-success" role="status"><%= exito %></div>
      <% } %>

      <form class="auth-form" action="/forgot-password" method="POST" id="form-auth"
            data-texto="ENVIAR ENLACE" data-texto-cargando="ENVIANDO...">
        <div class="campo-linea">
          <span class="material-symbols-outlined">mail</span>
          <input type="email" name="correo" value="<%= correo %>" aria-label="Correo electrónico"
                 placeholder="Correo electrónico" autocomplete="email" required autofocus>
        </div>

        <button type="submit" class="btn-neon btn-separado">
          <span class="spinner" aria-hidden="true"></span>
          <span class="btn-texto">ENVIAR ENLACE</span>
        </button>
      </form>

      <p class="auth-pie">¿La recordaste? <a href="/login">Inicia Sesión</a></p>
    </section>
  </main>

  <script src="/js/auth-form.js"></script>
</body>
</html>
