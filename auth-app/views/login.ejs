<!DOCTYPE html>
<html lang="es" class="overflow-x-clip">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0a">
  <title>SearchMatch | Iniciar sesión</title>
  <meta name="description" content="Inicia sesión en SearchMatch para ver tus partidos, tu carta y tus próximos rivales.">
  <!-- Fuentes e íconos de Google (los mismos del resto del sitio) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0" rel="stylesheet">
  <!-- Tailwind (CDN) con la configuración del sitio -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <!-- App de React (módulo ES, sin paso de compilación) -->
  <script type="module" src="/js/acceso.js"></script>
</head>
<body class="min-h-screen overflow-x-clip bg-ink font-sans text-base text-white antialiased selection:bg-neon selection:text-black">

  <!-- React monta aquí la pantalla de acceso. data-error / data-exito: mensajes de una sola vez (flash) -->
  <div id="acceso" data-error="<%= error || '' %>" data-exito="<%= exito || '' %>"></div>

  <noscript>
    <p style="padding:24px;font-family:sans-serif;color:#fff">Activa JavaScript para iniciar sesión.</p>
  </noscript>
</body>
</html>
