<!DOCTYPE html>
<html lang="es" class="overflow-x-clip">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0a">
  <title>SearchMatch | Crea tu perfil</title>
  <meta name="description" content="Completa tus datos personales y tu perfil deportivo en SearchMatch.">
  <!-- Fuentes e íconos de Google (los mismos del resto de la app) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0" rel="stylesheet">
  <!-- Esta página usa Tailwind (CDN) en vez de styles.css; la configuración está en tailwind-config.js -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <!-- App de React (módulo ES, sin paso de compilación) -->
  <script type="module" src="/js/onboarding.js"></script>
</head>
<body class="min-h-screen overflow-x-clip bg-ink font-sans text-base text-white antialiased selection:bg-neon selection:text-black">

  <!-- React monta aquí la página completa. Los data-* pasan datos del servidor a la app -->
  <div id="onboarding" data-fecha="<%= fechaNacimiento %>" data-tipo="<%= tipoCuenta %>"
    data-correo="<%= correo %>" data-comunas="<%= JSON.stringify(comunas) %>" data-hoy="<%= hoy %>"></div>

  <noscript>
    <p style="padding:24px;font-family:sans-serif;color:#fff">Activa JavaScript para completar tu registro.</p>
  </noscript>
</body>
</html>
