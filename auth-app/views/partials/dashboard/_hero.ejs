<!-- Saludo corto arriba de la tarjeta: nombre y posición vienen del controlador -->
<div class="panel-saludo">
  <h1 class="panel-saludo-titulo">Hola, <span class="icono-verde"><%= usuario.nombre %></span></h1>
  <p class="panel-saludo-sub">Jugador · <%= usuario.posicion %> · ¿Listo para volver a la cancha?</p>
</div>

<!-- Tarjeta principal: texto a la izquierda, balón brillante a la derecha -->
<section class="panel-hero">
  <div class="panel-hero-texto">
    <span class="badge-listo"><span class="punto-verde"></span>SearchMatch</span>
    <h2 class="panel-hero-titulo">Tu próximo partido <span>empieza aquí</span></h2>
    <p class="panel-hero-desc">Encuentra partidos, arma tu equipo y vive la experiencia del fútbol amateur.</p>
    <!-- Etapa 2: solo visual, no busca de verdad todavía -->
    <a href="#" class="panel-hero-btn">Buscar partido <span class="material-symbols-outlined">arrow_forward</span></a>
  </div>

  <!-- Pelota 3D: el mismo componente de la landing (ver /js/ball.js).
       ball.js dibuja dentro de #ball-canvas y la hace girar y flotar. -->
  <div class="ball-stage">
    <div class="ball-foco"></div>
    <div class="ball-anillo"></div>
    <div id="ball-canvas" aria-hidden="true"></div>
    <!-- Velocidad del remate (solo aparece al tocar la pelota) -->
    <div class="ball-hud" aria-hidden="true">
      <span class="ball-hud-titulo">Remate</span>
      <strong><span class="ball-hud-vel">0</span> km/h</strong>
      <small>Récord <span class="ball-hud-record">0</span> km/h</small>
    </div>
  </div>
</section>
