<!DOCTYPE html>
<html lang="es" class="overflow-x-clip">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0a">
  <title>SearchMatch | <%= propio ? 'Mi carta de jugador' : 'Carta de jugador' %></title>
  <meta name="description" content="Carta de jugador de SearchMatch: posición, valoración y estadísticas.">
  <!-- Fuentes e íconos de Google. crossorigin: "Descargar carta" necesita leerlas para incluirlas en la imagen -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0" rel="stylesheet" crossorigin="anonymous">
  <!-- Tailwind (CDN) con la configuración del sitio -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/js/tailwind-config.js"></script>
  <!-- App de React (módulo ES, sin paso de compilación) -->
  <script type="module" src="/js/perfil.js"></script>
</head>
<body class="min-h-screen overflow-x-clip bg-ink font-sans text-base text-white antialiased selection:bg-neon selection:text-black">

  <!-- React monta aquí la página. data-jugador trae los datos de la carta (o nada si no existe) -->
  <div id="perfil" data-jugador="<%= jugador ? JSON.stringify(jugador) : '' %>" data-propio="<%= propio %>"></div>

  <noscript>
    <p style="padding:24px;font-family:sans-serif;color:#fff">Activa JavaScript para ver la carta de jugador.</p>
  </noscript>
</body>
</html>
