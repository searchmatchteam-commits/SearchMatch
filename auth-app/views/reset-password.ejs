<%- include('partials/head', { titulo: 'Nueva contraseña', descripcion: 'Crea una contraseña nueva para tu cuenta de SearchMatch.', scripts: ['/js/auth-form.js', '/js/reset-password.js'] }) %>
<body class="auth-body auth-pagina">

  <%- include('partials/auth-nav', { accion: 'login' }) %>

  <!-- Contenido centrado (mismo estilo que el login) -->
  <main class="auth-centro">
    <section class="auth">
      <div class="auth-logo"><span class="material-symbols-outlined">key</span></div>
      <h1 class="auth-titulo">Nueva contraseña</h1>
      <p class="auth-subtitulo">Elige una contraseña nueva para tu cuenta</p>

      <!-- Errores del servidor, o de reset-password.js si el enlace del correo no sirve -->
      <div class="alert alert-error" role="alert" id="error-reset" <%= error ? '' : 'hidden' %>><%= error %></div>

      <!-- Si hubo un error con un enlace inválido, el formulario ya no sirve: se oculta -->
      <form class="auth-form" action="/reset-password" method="POST" id="form-auth"
            data-texto="GUARDAR CONTRASEÑA" data-texto-cargando="GUARDANDO..."
            <%= error && !tokens ? 'hidden' : '' %>>
        <!-- Tokens del enlace del correo: los completa reset-password.js, o el servidor
             los devuelve si hubo un error con la contraseña -->
        <input type="hidden" name="access_token" id="access_token" value="<%= tokens ? tokens.access_token : '' %>">
        <input type="hidden" name="refresh_token" id="refresh_token" value="<%= tokens ? tokens.refresh_token : '' %>">

        <div class="campo-linea">
          <span class="material-symbols-outlined">lock</span>
          <input type="password" id="contrasena" name="contrasena" aria-label="Contraseña nueva"
                 placeholder="Contraseña nueva (8 a 72 caracteres)" autocomplete="new-password"
                 minlength="8" maxlength="72" required autofocus>
          <button type="button" class="btn-ojo" data-ver="contrasena" aria-label="Mostrar contraseña">
            <span class="material-symbols-outlined">visibility</span>
          </button>
        </div>

        <div class="campo-linea">
          <span class="material-symbols-outlined">lock_reset</span>
          <input type="password" id="confirmar" name="confirmar" aria-label="Confirma tu contraseña"
                 placeholder="Confirma tu contraseña" autocomplete="new-password"
                 minlength="8" maxlength="72" required>
          <button type="button" class="btn-ojo" data-ver="confirmar" aria-label="Mostrar contraseña">
            <span class="material-symbols-outlined">visibility</span>
          </button>
        </div>

        <button type="submit" class="btn-neon btn-separado">
          <span class="spinner" aria-hidden="true"></span>
          <span class="btn-texto">GUARDAR CONTRASEÑA</span>
        </button>
      </form>

      <p class="auth-pie">¿El enlace expiró? <a href="/forgot-password">Pide uno nuevo</a></p>
    </section>
  </main>

  <!-- Sin <script> en el EJS: auth-form.js y reset-password.js se cargan con defer desde partials/head -->
</body>
</html>
